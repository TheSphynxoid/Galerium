{% extends 'base.html.twig' %}

{% block title %}Forum{% endblock %}

{% block body %}
<div class="container my-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-dark">Forum: {{ forum.titre }}</h1>
        <a class="btn btn-outline-primary btn-sm" href="{{ path('app_forum_index') }}">Back to List</a>
    </div>

    <!-- Discussions Card -->
    <div class="card p-3 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 text-dark">Discussions</h2>
            <a class="btn btn-sm btn-primary" href="{{ path('app_discussion_new', {'forum': forum.id}) }}">New Discussion</a>
        </div>
        <input type="text" id="discussion-search" class="form-control mt-3" placeholder="Search discussions..." />
    </div>

    <!-- Discussions List -->
    {% if discussions is defined and discussions|length > 0 %}
        <ul id="discussion-list" class="list-group list-group-flush mb-3">
            {% for d in discussions %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a class="text-dark text-decoration-none" href="{{ path('app_discussion_show', {'id': d.id}) }}">
                        {{ d.titre }}
                    </a>
                    <small class="text-muted">{{ d.dateCreation ? d.dateCreation|date('Y-m-d H:i') : '' }}</small>
                </li>
            {% endfor %}
        </ul>

        {% if pages is defined and pages > 1 %}
            <nav aria-label="Discussion pagination" id="pagination-container">
                <ul class="pagination justify-content-center">
                    <li class="page-item {{ page <= 1 ? 'disabled' }}">
                        <a class="page-link" href="{{ path('app_forum_show', {'id': forum.id, 'page': page-1}) }}">Previous</a>
                    </li>
                    {% for p in 1..pages %}
                        <li class="page-item {{ p == page ? 'active' }}">
                            <a class="page-link" href="{{ path('app_forum_show', {'id': forum.id, 'page': p}) }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item {{ page >= pages ? 'disabled' }}">
                        <a class="page-link" href="{{ path('app_forum_show', {'id': forum.id, 'page': page+1}) }}">Next</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <p class="text-dark">No discussions yet.</p>
        <ul id="discussion-list" class="list-group list-group-flush"></ul>
    {% endif %}

</div>

<script>
const searchInput = document.getElementById('discussion-search');
const discussionList = document.getElementById('discussion-list');
const paginationContainer = document.getElementById('pagination-container');

searchInput.addEventListener('input', function () {
    const query = this.value.trim();

    if (paginationContainer) {
        paginationContainer.style.display = query.length > 0 ? 'none' : 'block';
    }

    fetch(`{{ path('app_forum_discussion_search', {'id': forum.id}) }}?q=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
            discussionList.innerHTML = '';

            if (data.length === 0) {
                discussionList.innerHTML = '<li class="list-group-item">No discussions found.</li>';
                return;
            }

            data.forEach(discussion => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.innerHTML = `
                    <a class="text-dark text-decoration-none" href="/discussion/${discussion.id}">${discussion.titre}</a>
                    <small class="text-muted">${discussion.dateCreation}</small>
                `;
                discussionList.appendChild(li);
            });
        })
        .catch(err => console.error('Error fetching discussions:', err));
});
</script>
{% endblock %}
