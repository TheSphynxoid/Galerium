{% extends 'base.html.twig' %}

{% block title %}Modifier le forum - {{ forum.titre }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Modifier le forum</h1>
        <a href="{{ path('app_forum_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                <div class="col-12">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.categorie) }}
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.categorie) }}
                </div>

                <div class="col-12 d-flex justify-content-between">
                    <a href="{{ path('app_forum_index') }}" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Mettre à jour
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# Zone de suppression (danger) #}
    <div class="card border-danger mt-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Supprimer ce forum</h2>
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                ⚠️ Cette action est <strong>irréversible</strong>. 
                Toutes les discussions et commentaires associés seront supprimés.
            </p>
            {{ include('forum/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}