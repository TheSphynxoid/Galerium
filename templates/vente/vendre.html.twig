{% extends 'base.html.twig' %}

{% block title %}Acheter {{ oeuvre.title }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h1 class="h3 mb-4 fw-bold text-center">Finaliser l'achat</h1>
                    
                    <div class="text-center mb-4">
                        {% if oeuvre.imagePath %}
                            <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                 class="img-fluid rounded shadow-sm mb-3" 
                                 style="max-height: 200px; object-fit: cover;"
                                 alt="{{ oeuvre.title }}">
                        {% endif %}
                        <h2 class="h5">{{ oeuvre.title }}</h2>
                        <p class="text-muted">par {{ oeuvre.artiste.displayName }}</p>
                    </div>

                    <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded mb-4">
                        <span class="fs-5">Total à payer :</span>
                        <span class="fs-4 fw-bold text-success">{{ oeuvre.price|number_format(2, ',', ' ') }} TND</span>
                    </div>

                    {{ form_start(form) }}
                        {{ form_widget(form.submit, {'label': 'Payer ' ~ oeuvre.price ~ ' TND avec Stripe'}) }}
                    {{ form_end(form) }}

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-lock"></i> Paiement sécurisé par Stripe</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
