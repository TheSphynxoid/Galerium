{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-group">
        <label>{{ form_label(form.email) }}</label>
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.email) }}</div>
    </div>

    <div class="form-group">
        <label>{{ form_label(form.password) }}</label>
        {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.password) }}</div>
    </div>

    <div class="form-group">
        <label>{{ form_label(form.nom) }}</label>
        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.nom) }}</div>
    </div>

    <div class="form-group">
        <label>{{ form_label(form.prenom) }}</label>
        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.prenom) }}</div>
    </div>

    <div class="form-group">
        <label>{{ form_label(form.role) }}</label>
        {{ form_widget(form.role, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.role) }}</div>
    </div>

    <div class="form-group">
        <label>{{ form_label(form.dateInscription) }}</label>
        {{ form_widget(form.dateInscription, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger">{{ form_errors(form.dateInscription) }}</div>
    </div>

    <button class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
