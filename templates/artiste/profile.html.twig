{% extends 'base.html.twig' %}

{% block title %}Mon profil artiste{% endblock %}

{% block body %}
<section id="profile-edit" class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="mb-4">Mon profil artiste</h2>

                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                {% if form_errors(form) is not empty %}
                    <div class="alert alert-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}
                <h4>{{ artiste.prenom }} {{ artiste.nom }}</h4>
                <p class="text-muted">{{ artiste.email }}</p>
                {% if artiste.specialty %}
                    <p><strong>Spécialité:</strong> {{ artiste.specialty }}</p>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Modifier mon profil</h3>
            </div>
            <div class="card-body">
                {{ form_start(profileForm, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    <div class="mb-3">
                        {{ form_row(profileForm.specialty) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(profileForm.biography) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(profileForm.website) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.behance, 'Behance', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.behance, {'attr': {'class': 'form-control', 'placeholder': 'https://behance.net/...'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.behance) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.imageFile, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-text">Formats acceptés : JPG, PNG. Taille max : 5MB</div>
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.imageFile) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary form-action-btn">Enregistrer</button>
                            <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary form-action-btn">Annuler</a>
                        </div>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>

<style>
.form-action-btn {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0.5rem 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}
.form-action-btn:hover {
    transform: translateY(-2px);
}
.d-flex.gap-2 { gap: 0.5rem; }
</style>
{% endblock %}
