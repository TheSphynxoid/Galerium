{% extends 'base.html.twig' %}

{% block title %}{{ artiste.displayName }} - Profil Artiste{% endblock %}

{% block body %}
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-md-4 text-center">
                {% if artiste.avatarPath %}
                    <img src="{{ vich_uploader_asset(artiste, 'imageFile') }}" 
                         alt="{{ artiste.displayName }}" 
                         class="rounded-circle shadow-lg mb-4 mb-md-0" 
                         style="width: 250px; height: 250px; object-fit: cover; border: 5px solid white;">
                {% else %}
                    <div class="rounded-circle shadow-lg bg-white d-inline-flex align-items-center justify-content-center mb-4 mb-md-0" 
                         style="width: 250px; height: 250px; border: 5px solid white;">
                        <i class="bi bi-person display-1 text-muted"></i>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-8">
                <h1 class="display-4 fw-bold mb-2">{{ artiste.displayName }}</h1>
                <p class="h4 text-muted mb-4">{{ artiste.specialty }}</p>
                
                <div class="bg-white p-4 rounded shadow-sm mb-4">
                    <h5 class="fw-bold mb-3">Biographie</h5>
                    <p class="mb-0 text-secondary" style="line-height: 1.8;">
                        {{ artiste.biography ?: 'Aucune biographie disponible.' }}
                    </p>
                </div>

                <div class="d-flex gap-3">
                    {% if artiste.website %}
                        <a href="{{ artiste.website }}" target="_blank" class="btn btn-outline-dark">
                            <i class="bi bi-globe"></i> Site Web
                        </a>
                    {% endif %}
                    {% if artiste.instagram %}
                        <a href="{{ artiste.instagram }}" target="_blank" class="btn btn-outline-danger">
                            <i class="bi bi-instagram"></i> Instagram
                        </a>
                    {% endif %}
                    {% if artiste.facebook %}
                        <a href="{{ artiste.facebook }}" target="_blank" class="btn btn-outline-primary">
                            <i class="bi bi-facebook"></i> Facebook
                        </a>
                    {% endif %}
                    {% if artiste.behance %}
                        <a href="{{ artiste.behance }}" target="_blank" class="btn btn-primary">
                            <i class="bi bi-behance"></i> Behance
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <h3 class="border-bottom pb-3 mb-4">Œuvres de l'artiste <span class="badge bg-secondary rounded-pill align-top fs-6 ms-2">{{ oeuvres|length }}</span></h3>
            </div>
        </div>

        {% if oeuvres is empty %}
            <div class="text-center py-5">
                <p class="text-muted fs-5">Cet artiste n'a pas encore exposé d'œuvres.</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for oeuvre in oeuvres %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden" style="transition: transform 0.3s ease;">
                            <div class="position-relative" style="height: 300px;">
                                <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                     class="w-100 h-100" 
                                     alt="{{ oeuvre.title }}" 
                                     style="object-fit: cover;">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title fw-bold">{{ oeuvre.title }}</h5>
                                {% if oeuvre.price %}
                                    <p class="fw-bold text-success">{{ oeuvre.price|number_format(2, ',', ' ') }} TND</p>
                                {% endif %}
                                <div class="d-flex justify-content-between align-items-center text-muted small mt-3">
                                    <span><i class="bi bi-eye"></i> {{ oeuvre.viewsCount }}</span>
                                    <span><i class="bi bi-calendar"></i> {{ oeuvre.createdAt|date('d/m/Y') }}</span>
                                </div>
                                <div class="mt-3">
                                    <a href="{{ path('app_vente', {id: oeuvre.id}) }}" class="btn btn-sm btn-outline-success w-100">
                                        <i class="bi bi-cart"></i> Acheter
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
{% endblock %}
