{% extends 'base.html.twig' %}

{% block title %}Dashboard artiste{% endblock %}

{% block body %}
<section id="dashboard" class="py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                {% if not artiste.avatarPath %}
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <div>
                            <strong>Attention !</strong> Vous n'avez pas ajouté d'image à votre profil. 
                            <a href="{{ path('app_artiste_profile') }}" class="alert-link">Veuillez en ajouter une ici</a>.
                        </div>
                    </div>
                {% endif %}
            </div>
            
            <div class="col-12 d-flex justify-content-between align-items-center">
                <div>
                    <h2>Bienvenue, {{ artiste.displayName }}</h2>
                    <p class="text-muted">Gérez vos œuvres et suivez vos performances</p>
                </div>
                <div>
                {#-outline #}
                    <a class="btn btn-dark me-2" href="{{ path('app_oeuvre_gallery') }}">Voir les œuvres</a>
                    <a class="btn btn-dark me-2" href="{{ path('app_artiste_profile') }}">Modifier mon profil</a>
                    <a class="btn btn-primary" href="{{ path('app_oeuvre_new') }}">Ajouter une œuvre</a>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <h3 class="mb-0">{{ oeuvres|length }}</h3>
                    <p class="text-muted mb-0">Œuvres publiées</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <h3 class="mb-0">{{ totalViews }}</h3>
                    <p class="text-muted mb-0">Vues totales</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <h3 class="mb-0">{{ totalVotes }}</h3>
                    <p class="text-muted mb-0">Votes totaux</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center p-4">
                    <h3 class="mb-0">{{ totalFavorites }}</h3>
                    <p class="text-muted mb-0">Favoris totaux</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <h3 class="mb-4">Mes œuvres</h3>
                {% if oeuvres|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Titre</th>
                                    <th>Statut</th>
                                    <th>Vues</th>
                                    <th>Votes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for oeuvre in oeuvres %}
                                    <tr>
                                        <td>
                                            <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                                 alt="{{ oeuvre.title }}" 
                                                 style="width:60px;height:60px;object-fit:cover;" 
                                                 class="rounded">
                                        </td>
                                        <td>{{ oeuvre.title }}</td>
                                        <td>
                                            {% if oeuvre.status == 'public' %}
                                                <span class="badge bg-success">Publiée</span>
                                            {% elseif oeuvre.status == 'draft' %}
                                                <span class="badge bg-secondary">Brouillon</span>
                                            {% elseif oeuvre.status == 'private' %}
                                                <span class="badge bg-warning text-dark">Privée</span>
                                            {% else %}
                                                <span class="badge bg-dark">Archivée</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ oeuvre.viewsCount }}</td>
                                        <td>{{ oeuvre.votesCount }}</td>
                                        <td>
                                            <a href="{{ path('app_oeuvre_show', {id: oeuvre.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                            <a href="{{ path('app_oeuvre_edit', {id: oeuvre.id}) }}" class="btn btn-sm btn-dark">Modifier</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <p class="text-muted">Vous n'avez pas encore publié d'œuvre.</p>
                        <a href="{{ path('app_oeuvre_new') }}" class="btn btn-primary">Ajouter votre première œuvre</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
