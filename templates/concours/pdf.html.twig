<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            background: #f7f7f7;
        }

        h1 {
            text-align: center;
            color: #b51d1d;
            margin-bottom: 25px;
        }

        .container {
            width: 100%;
            padding: 10px;
        }

        /* ----- CARD STYLE ----- */
        .card {
            border: 2px solid #4a2d86;
            background: #ffffff;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .card h3 {
            color: #0428B5;
            text-align: center;
            margin-bottom: 10px;
        }

        .badge {
            padding: 4px 8px;
            border-radius: 4px;
            color: white;
            font-size: 11px;
        }

        .bg-success { background: #28a745; }
        .bg-danger  { background: #dc3545; }

        p {
            margin: 4px 0;
        }

        .label {
            font-weight: bold;
        }

    </style>
</head>

<body>

<h1>Liste des Concours Disponibles</h1>

<div class="container">

    {% for c in concours %}

        <div class="card">

            <h3>{{ c.titre }}</h3>

            <p>
                <span class="label">Statut :</span>
                {% set badge =
                    c.statut == 'Actif' ? 'bg-success' :
                    (c.statut == 'cloturé' ? 'bg-danger' : 'bg-danger')
                %}
                <span class="badge {{ badge }}">{{ c.statut }}</span>
            </p>

            <p><span class="label">Description :</span> {{ c.description }}</p>

            <p>
                <span class="label">Date Début :</span>
                {{ c.dateDebut ? c.dateDebut|date('d/m/Y') : '—' }}
            </p>

            <p>
                <span class="label">Date Fin :</span>
                {{ c.dateFin ? c.dateFin|date('d/m/Y') : '—' }}
            </p>

            <p>
                <span class="label">Règles :</span> 
                {{ c.regles ?: '—' }}
            </p>

            <p>
                <span class="label">Vote Public :</span>
                <span class="badge {{ c.votePublic ? 'bg-success' : 'bg-danger' }}">
                    {{ c.votePublic ? 'Oui' : 'Non' }}
                </span>
            </p>

            <p>
                <span class="label">Début Vote :</span>
                {{ c.dateDebutVote ? c.dateDebutVote|date('d/m/Y') : '—' }}
            </p>

            <p>
                <span class="label">Fin Vote :</span>
                {{ c.dateFinVote ? c.dateFinVote|date('d/m/Y') : '—' }}
            </p>

        </div>

    {% endfor %}

</div>

</body>
</html>
