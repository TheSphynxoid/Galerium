{% extends 'base.html.twig' %}

{% block title %}Nouvelle enchère{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <p class="text-uppercase text-muted small mb-1">Espace artiste</p>
            <h1 class="h3 mb-1 text-dark">Mettre une oeuvre aux enchères</h1>
            <p class="text-muted mb-0">Choisissez une oeuvre, définissez vos paramètres, et publiez-la immédiatement.</p>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('app_enchere_index') }}">Retour à mes enchères</a>
    </div>

    {{ include('enchere/_form.html.twig', {
        button_label: "Lancer l'enchère",
        preview_enabled: true
    }) }}
</div>
{% endblock %}
