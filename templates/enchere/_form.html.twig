{% set preview = preview_enabled is defined and preview_enabled %}
{% set formColClass = preview ? 'col-lg-7' : 'col-12' %}

{{ form_start(form, { attr: { class: 'enchere-form' } }) }}
    {{ form_errors(form) }}

    <div class="row g-4 align-items-start">
        <div class="{{ formColClass }}">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="mb-4">
                        {{ form_label(form.oeuvre, "Oeuvre à mettre aux enchères", { label_attr: { class: 'form-label fw-semibold' } }) }}
                        {{ form_widget(form.oeuvre, { attr: { class: 'form-select' } }) }}
                        {{ form_help(form.oeuvre) }}
                        {{ form_errors(form.oeuvre) }}
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(form.prixDeBase, {
                                label: 'Prix de base (TND)',
                                attr: { class: 'form-control', min: 0, step: '0.01' }
                            }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.dateFin, {
                                label: 'Date de fin',
                                attr: { class: 'form-control', type: 'datetime-local' }
                            }) }}
                        </div>
                    </div>

                    {{ form_rest(form) }}

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mt-4">
                        <a class="btn btn-outline-secondary" href="{{ path('app_enchere_index') }}">Annuler</a>
                        <button class="btn btn-primary px-4">{{ button_label|default('Save') }}</button>
                    </div>
                </div>
            </div>
        </div>

        {% if preview %}
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100" id="oeuvre-preview">
                <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                    <img id="oeuvre-preview-image" src="{{ asset('images/galerium.png') }}" alt="Prévisualisation de l'oeuvre" class="w-100 h-100" style="object-fit: cover;">
                </div>
                <div class="card-body">
                    <p class="text-uppercase text-muted small mb-2">Aperçu de l'oeuvre</p>
                    <h5 id="oeuvre-preview-title" class="mb-1">Sélectionnez une oeuvre</h5>
                    <p id="oeuvre-preview-artist" class="text-secondary small mb-2">L'artiste apparaîtra ici</p>
                    <p id="oeuvre-preview-description" class="small text-muted mb-0">Choisissez une oeuvre pour voir sa description et son image avant de publier.</p>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    {% if preview %}
    <script>
        (() => {
            const select = document.querySelector('[name="{{ form.oeuvre.vars.full_name }}"]');
            if (!select) {
                return;
            }

            const oeuvreData = {
                {% for choice in form.oeuvre.vars.choices %}
                "{{ choice.value }}": {
                    title: "{{ choice.data.title|e('js') }}",
                    description: "{{ choice.data.description|u.truncate(200, '...')|e('js') }}",
                    artist: "{{ (choice.data.artiste ? choice.data.artiste.displayName : 'Artiste')|e('js') }}",
                    image: "{{ choice.data.imagePath ? asset('uploads/oeuvres/' ~ choice.data.imagePath) : asset('images/galerium.png') }}"
                },
                {% endfor %}
            };

            const img = document.getElementById('oeuvre-preview-image');
            const title = document.getElementById('oeuvre-preview-title');
            const artist = document.getElementById('oeuvre-preview-artist');
            const description = document.getElementById('oeuvre-preview-description');

            const resetPreview = () => {
                img.src = "{{ asset('images/galerium.png') }}";
                title.textContent = 'Sélectionnez une oeuvre';
                artist.textContent = "L'artiste apparaîtra ici";
                description.textContent = 'Choisissez une oeuvre pour voir sa description et son image avant de publier.';
            };

            const updatePreview = (value) => {
                const item = oeuvreData[value];
                if (!item) {
                    resetPreview();
                    return;
                }

                img.src = item.image;
                title.textContent = item.title || 'Oeuvre sélectionnée';
                artist.textContent = item.artist || '';
                description.textContent = item.description || 'Aucune description disponible.';
            };

            select.addEventListener('change', (event) => updatePreview(event.target.value));
            updatePreview(select.value);
        })();
    </script>
    {% endif %}
{{ form_end(form, { render_rest: false }) }}
