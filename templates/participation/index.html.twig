{% extends 'base.html.twig' %}

{% block title %}Participation index{% endblock %}

{% block body %}
    <h1>Participation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dateparticipation</th>
                <th>Statut</th>
                <th>Votepublic</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for participation in participations %}
            <tr>
                <td>{{ participation.id }}</td>
                <td>{{ participation.dateparticipation ? participation.dateparticipation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ participation.statut }}</td>
                <td>{{ participation.votepublic }}</td>
                <td>{{ participation.description }}</td>
                <td>
                    <a href="{{ path('app_participation_show', {'id': participation.id}) }}">show</a>
                    <a href="{{ path('app_participation_edit', {'id': participation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>Participer à un concours</h2>
    <ul>
        {% for concours in concoursList %}
            <li>
                {{ concours.titre }} -
                <a href="{{ path('app_participation_new', {'concoursId': concours.id}) }}">Participer</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
