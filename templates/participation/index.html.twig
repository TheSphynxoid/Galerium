{% extends 'backoffice.html.twig' %}

{% block title %}Participation index{% endblock %}

{% block body %}
    <h1>Participation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dateparticipation</th>
                <th>Statut</th>
                <th>Oeuvre</th>
                <th>Votes</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for participation in participations %}
            <tr>
                <td>{{ participation.id }}</td>
                <td>{{ participation.dateparticipation ? participation.dateparticipation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ participation.statut }}</td>
                <td>
                    {% if participation.oeuvre %}
                        {{ participation.oeuvre.title }}
                    {% else %}
                        <span class="text-muted">Aucune œuvre</span>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-success">
                        <i class="bi bi-heart-fill"></i> {{ votesCount[participation.id] ?? 0 }} vote(s)
                    </span>
                </td>
                <td>{{ participation.description }}</td>
                <td>
                    <a href="{{ path('app_participation_show', {'id': participation.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_participation_edit_status', {'id': participation.id}) }}" class="btn btn-sm btn-warning">Modifier statut</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

  
{% endblock %}
