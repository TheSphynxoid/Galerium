{% extends 'backoffice.html.twig' %}

{% block title %}Participation{% endblock %}

{% block body %}
    <h1>Participation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ participation.id }}</td>
            </tr>
            <tr>
                <th>Dateparticipation</th>
                <td>{{ participation.dateparticipation ? participation.dateparticipation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ participation.statut }}</td>
            </tr>
            <tr>
                <th>Oeuvre</th>
                <td>
                    {% if participation.oeuvre %}
                        <div class="d-flex align-items-center">
                            {% if participation.oeuvre.imagePath %}
                                <img src="{{ vich_uploader_asset(participation.oeuvre, 'imageFile') }}" 
                                     alt="{{ participation.oeuvre.title }}" 
                                     class="img-thumbnail me-2" 
                                     style="max-width: 100px; max-height: 100px; object-fit: cover;">
                            {% endif %}
                            <div>
                                <strong>{{ participation.oeuvre.title }}</strong>
                            </div>
                        </div>
                    {% else %}
                        <span class="text-muted">Aucune œuvre</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Nombre de votes</th>
                <td>
                    <span class="badge bg-success">
                        <i class="bi bi-heart-fill"></i> {{ votesCount ?? 0 }} vote(s)
                    </span>
                </td>
            </tr>
            <tr>
                <th>Vote public activé</th>
                <td>
                    <span class="badge {{ participation.votepublic ? 'bg-success' : 'bg-secondary' }}">
                        {{ participation.votepublic ? 'Oui' : 'Non' }}
                    </span>
                </td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ participation.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_participation_index') }}">back to list</a>

    <a href="{{ path('app_participation_edit', {'id': participation.id}) }}">edit</a>

    {{ include('participation/_delete_form.html.twig') }}
{% endblock %}
