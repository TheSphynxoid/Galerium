{% extends 'base.html.twig' %}

{% block title %}Participer au concours{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-lg p-4" style="border-radius: 12px; border: 2px solid #0428B5;">
                    <div class="card-body">

                        <h2 class="card-title text-center text-primary mb-3">
                            Participer au concours : {{ concour.titre }}
                        </h2>

                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item"><strong>Statut :</strong> {{ concour.statut }}</li>
                            <li class="list-group-item"><strong>Description :</strong> {{ concour.description }}</li>
                            <li class="list-group-item"><strong>Date Début :</strong> {{ concour.dateDebut ? concour.dateDebut|date('d/m/Y') : '—' }}</li>
                            <li class="list-group-item"><strong>Date Fin :</strong> {{ concour.dateFin ? concour.dateFin|date('d/m/Y') : '—' }}</li>
                            <li class="list-group-item"><strong>Règles :</strong> {{ concour.regles ?: '—' }}</li>
                            <li class="list-group-item"><strong>Vote public :</strong> {{ concour.votePublic ? 'Oui' : 'Non' }}</li>
                            <li class="list-group-item"><strong>Date Début Vote :</strong> {{ concour.dateDebutVote ? concour.dateDebutVote|date('d/m/Y') : '—' }}</li>
                            <li class="list-group-item"><strong>Date Fin Vote :</strong> {{ concour.dateFinVote ? concour.dateFinVote|date('d/m/Y') : '—' }}</li>
                            {% if concour.scoreVote is defined %}
                                <li class="list-group-item"><strong>Score Vote :</strong> {{ concour.scoreVote ?: '—' }}</li>
                            {% endif %}
                        </ul>

                        <h5 class="text-center text-secondary mb-3">Votre participation</h5>

                        {{ form_start(form) }}

                            <div class="mb-3">
                                {{ form_label(form.oeuvre) }}
                                {{ form_widget(form.oeuvre, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.oeuvre) }}
                                
                                {# Affichage des images des œuvres disponibles #}
                                <div class="mt-3">
                                    <small class="text-muted d-block mb-2">Vos œuvres disponibles :</small>
                                    <div class="row g-2">
                                        {% for oeuvre in oeuvres %}
                                            <div class="col-6 col-md-4">
                                                <div class="card oeuvre-preview" data-oeuvre-id="{{ oeuvre.id }}" style="cursor: pointer; border: 2px solid transparent; transition: all 0.3s;">
                                                    {% if oeuvre.imagePath %}
                                                        <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                                             class="card-img-top" 
                                                             alt="{{ oeuvre.title }}"
                                                             style="height: 120px; object-fit: cover;">
                                                    {% else %}
                                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 120px;">
                                                            <span class="text-muted">Pas d'image</span>
                                                        </div>
                                                    {% endif %}
                                                    <div class="card-body p-2">
                                                        <small class="card-text text-truncate d-block">{{ oeuvre.title }}</small>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.statut) }}
                                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.statut) }}
                            </div>

                            {# 🔥 Affiche les autres champs restants : dateParticipation, noteFinale, etc. #}
                            {{ form_rest(form) }}

                            <!-- Bouton à la fin -->
                            <div class="d-grid mt-3">
                                <button type="submit" class="btn btn-success btn-lg">
                                    Envoyer ma participation
                                </button>
                            </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card-title {
        font-weight: 700;
    }
    .list-group-item {
        font-size: 0.95rem;
    }
    .oeuvre-preview:hover {
        border-color: #0428B5 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .oeuvre-preview.selected {
        border-color: #0428B5 !important;
        background-color: #f0f4ff;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const oeuvreSelect = document.querySelector('#{{ form.oeuvre.vars.id }}');
    const oeuvrePreviews = document.querySelectorAll('.oeuvre-preview');
    
    // Mettre à jour la sélection visuelle quand le select change
    oeuvreSelect.addEventListener('change', function() {
        const selectedId = this.value;
        oeuvrePreviews.forEach(preview => {
            preview.classList.remove('selected');
            if (preview.dataset.oeuvreId === selectedId) {
                preview.classList.add('selected');
            }
        });
    });
    
    // Permettre de cliquer sur une œuvre pour la sélectionner
    oeuvrePreviews.forEach(preview => {
        preview.addEventListener('click', function() {
            const oeuvreId = this.dataset.oeuvreId;
            oeuvreSelect.value = oeuvreId;
            oeuvreSelect.dispatchEvent(new Event('change'));
        });
    });
    
    // Initialiser l'état visuel au chargement
    if (oeuvreSelect.value) {
        oeuvreSelect.dispatchEvent(new Event('change'));
    }
});
</script>
{% endblock %}
