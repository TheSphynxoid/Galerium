{% extends 'base.html.twig' %}

{% block title %}Participer au concours{% endblock %}

{% block body %}
<section class="py-4">
    <div class="container">

        {# Flash Messages #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>⚠️ Attention !</strong> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>✅ Succès !</strong> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <h2 class="text-primary">Participer au concours : {{ concours.titre }}</h2>

        <div class="card p-3 mb-4">
        <p><strong>statut :</strong> {{ concours.statut }}</p>
            <p><strong>Date début :</strong> {{ concours.dateDebut|date('d/m/Y') }}</p>
            <p><strong>Date fin :</strong> {{ concours.dateFin|date('d/m/Y') }}</p>
            <p><strong>Description :</strong> {{ concours.description }}</p>
            <p><strong>Règles :</strong> {{ concours.regles }}</p>
                         <p class="mb-1">
    <strong>Vote public :</strong>
    <span class="badge {{ concours.votePublic ? 'bg-success' : 'bg-danger' }}">
        {{ concours.votePublic ? 'Oui' : 'Non' }}
    </span>
</p>
            <p><strong>Date début vote :</strong> {{ concours.dateDebutVote|date('d/m/Y') }}</p>
            <p><strong>Date fin vote :</strong> {{ concours.dateFinVote|date('d/m/Y') }}</p>



        </div>

        <h3 class="mt-4">Formulaire de participation</h3>
        {{ form_start(form) }}
            <div class="mb-4">
                <label class="form-label fw-bold mb-3">Choisir une seule œuvre *</label>
                <div class="row g-3" id="oeuvre-selection">
                    {% for oeuvre in oeuvres %}
                        <div class="col-md-4 col-sm-6">
                            <div class="card oeuvre-card h-100" data-oeuvre-id="{{ oeuvre.id }}" style="cursor: pointer; transition: all 0.3s;">
                                {% if oeuvre.imagePath %}
                                    <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" class="card-img-top" alt="{{ oeuvre.title }}" style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <span class="text-white">Pas d'image</span>
                                    </div>
                                {% endif %}
                                <div class="card-body">
                                    <h5 class="card-title">{{ oeuvre.title }}</h5>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-warning">
                                <p class="mb-0">Vous n'avez aucune œuvre. <a href="{{ path('app_oeuvre_new') }}">Créer une œuvre</a></p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-3" style="display: none;">
                    {{ form_widget(form.oeuvre) }}
                </div>
                {{ form_errors(form.oeuvre) }}
            </div>
            
           {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-success mt-3">Envoyer ma participation</button>
        {{ form_end(form) }}

        <style>
            .oeuvre-card {
                border: 2px solid #dee2e6;
            }
            .oeuvre-card:hover {
                border-color: #0d6efd;
                transform: translateY(-5px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            }
            .oeuvre-card.selected {
                border-color: #198754;
                background-color: #f0f8f4;
            }
            .oeuvre-card.selected .card-footer::after {
                content: "✓ Sélectionnée";
                display: block;
                color: #198754;
                font-weight: bold;
                text-align: center;
                padding: 5px;
            }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const oeuvreCards = document.querySelectorAll('.oeuvre-card');
                // Trouver le select du formulaire (peut avoir différents noms selon Symfony)
                const oeuvreSelect = document.querySelector('select[name*="[oeuvre]"]') || 
                                     document.querySelector('#participation_oeuvre') ||
                                     document.querySelector('select[id*="oeuvre"]');
                
                if (!oeuvreSelect) {
                    console.error('Impossible de trouver le champ select pour l\'œuvre');
                    return;
                }
                
                oeuvreCards.forEach(card => {
                    card.addEventListener('click', function() {
                        // Retirer la sélection précédente
                        oeuvreCards.forEach(c => c.classList.remove('selected'));
                        
                        // Ajouter la sélection à la carte cliquée
                        this.classList.add('selected');
                        
                        // Mettre à jour le select
                        const oeuvreId = this.getAttribute('data-oeuvre-id');
                        if (oeuvreSelect) {
                            oeuvreSelect.value = oeuvreId;
                            // Déclencher l'événement change pour que Symfony le détecte
                            oeuvreSelect.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    });
                });
                
                // Initialiser la sélection si une œuvre est déjà sélectionnée
                if (oeuvreSelect && oeuvreSelect.value) {
                    const selectedCard = document.querySelector(`[data-oeuvre-id="${oeuvreSelect.value}"]`);
                    if (selectedCard) {
                        selectedCard.classList.add('selected');
                    }
                }
            });
        </script>

    </div>
</section>
{% endblock %}
