{% extends 'base.html.twig' %}

{% block title %}Modifier ma participation{% endblock %}

{% block body %}
<section class="py-4">
    <div class="container">

        <h2 class="text-primary mb-4">Modifier ma participation</h2>

        {% set concoursCloture = false %}

        {% for concours in participation.concours %}
            <div class="card p-3 mb-4">
                <p><strong>Concours :</strong> {{ concours.titre }}</p>
                <p><strong>Statut :</strong> {{ concours.statut }}</p>
                <p><strong>Date début :</strong> {{ concours.dateDebut|date('d/m/Y') }}</p>
                <p><strong>Date fin :</strong> {{ concours.dateFin|date('d/m/Y') }}</p>
            </div>

            {% if concours.statut == 'cloturé' %}
                {% set concoursCloture = true %}
            {% endif %}
        {% endfor %}

        {% if concoursCloture %}
            <div class="alert alert-danger">
                <strong>⚠ Impossible de modifier :</strong> Ce concours est clôturé, vous ne pouvez plus modifier votre participation.
            </div>

            <a href="{{ path('app_participation_my') }}" class="btn btn-secondary mt-3">Retour</a>

        {% else %}
            <h3 class="mt-4">Modifier l'œuvre et la description</h3>

            {{ form_start(form) }}
                <div class="mb-4">
                    <label class="form-label fw-bold mb-3">Choisir une œuvre (image)</label>
                    <div class="row g-3" id="oeuvre-selection">
                        {% for oeuvre in oeuvres %}
                            <div class="col-md-4 col-sm-6">
                                <div class="card oeuvre-card h-100" data-oeuvre-id="{{ oeuvre.id }}" style="cursor: pointer; transition: all 0.3s;">
                                    {% if oeuvre.imagePath %}
                                        <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" class="card-img-top" alt="{{ oeuvre.title }}" style="height: 200px; object-fit: cover;">
                                    {% else %}
                                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                            <span class="text-white">Pas d'image</span>
                                        </div>
                                    {% endif %}
                                    <div class="card-body">
                                        <h5 class="card-title">{{ oeuvre.title }}</h5>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <p class="mb-0">Vous n'avez aucune œuvre. <a href="{{ path('app_oeuvre_new') }}">Créer une œuvre</a></p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="mt-3" style="display: none;">
                        {{ form_widget(form.oeuvre) }}
                    </div>
                    {{ form_errors(form.oeuvre) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Enregistrer les modifications</button>
                    <a href="{{ path('app_participation_my') }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}

            <style>
                .oeuvre-card {
                    border: 2px solid #dee2e6;
                }
                .oeuvre-card:hover {
                    border-color: #0d6efd;
                    transform: translateY(-5px);
                    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
                }
                .oeuvre-card.selected {
                    border-color: #198754;
                    background-color: #f0f8f4;
                }
                .oeuvre-card.selected::after {
                    content: "✓ Sélectionnée";
                    display: block;
                    color: #198754;
                    font-weight: bold;
                    text-align: center;
                    padding: 5px;
                }
            </style>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const oeuvreCards = document.querySelectorAll('.oeuvre-card');
                    const oeuvreSelect = document.querySelector('select[name*="[oeuvre]"]')
                        || document.querySelector('#participation_oeuvre')
                        || document.querySelector('select[id*="oeuvre"]');

                    if (!oeuvreSelect) {
                        console.error('Impossible de trouver le champ select pour l\'œuvre');
                        return;
                    }

                    oeuvreCards.forEach(card => {
                        card.addEventListener('click', function() {
                            oeuvreCards.forEach(c => c.classList.remove('selected'));
                            this.classList.add('selected');
                            const oeuvreId = this.getAttribute('data-oeuvre-id');
                            oeuvreSelect.value = oeuvreId;
                            oeuvreSelect.dispatchEvent(new Event('change', { bubbles: true }));
                        });
                    });

                    if (oeuvreSelect.value) {
                        const selectedCard = document.querySelector(`[data-oeuvre-id="${oeuvreSelect.value}"]`);
                        if (selectedCard) selectedCard.classList.add('selected');
                    }
                });
            </script>
        {% endif %}
    </div>
</section>
{% endblock %}
