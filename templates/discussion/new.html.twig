{% extends 'base.html.twig' %}

{% block title %}New Discussion{% endblock %}

{% block body %}
<div class="container my-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-dark">New Discussion in Forum: {{ forum ? forum.titre : 'Unknown Forum' }}</h1>
        <a class="btn btn-outline-primary btn-sm" href="{{ path('app_forum_show', {'id': forum ? forum.id}) }}">Back to Forum</a>
    </div>

    <!-- Form Card -->
    <div class="card p-4 shadow-sm" style="border-radius: 0.75rem;">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="mt-3">
                <button class="btn btn-primary">Create Discussion</button>
            </div>
        {{ form_end(form) }}
    </div>

</div>
{% endblock %}
