{% if oeuvres|length > 0 %}
    <div class="row g-4">
        {% for oeuvre in oeuvres %}
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 overflow-hidden" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
                    <div class="position-relative overflow-hidden" style="height: 300px;">
                        <a href="{{ path('app_oeuvre_details', {id: oeuvre.id}) }}" class="d-block w-100 h-100">
                            <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                 class="w-100 h-100" 
                                 alt="{{ oeuvre.title }}" 
                                 style="object-fit: cover; transition: transform 0.3s ease;"
                                 onmouseover="this.style.transform='scale(1.05)'"
                                 onmouseout="this.style.transform='scale(1)'">
                        </a>
                        <div class="position-absolute top-0 start-0 w-100 h-100" 
                             style="background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.7) 100%);"></div>
                        <div class="position-absolute bottom-0 start-0 p-3 text-white w-100">
                            <h5 class="mb-1 fw-bold">{{ oeuvre.title }}</h5>
                            <p class="mb-0 small opacity-75">
                                Par <a href="{{ path('app_artiste_show', {id: oeuvre.artiste.id}) }}" class="text-white text-decoration-none hover-underline">{{ oeuvre.artiste.displayName }}</a>
                            </p>
                            {% if oeuvre.price %}
                                <p class="mb-0 mt-1 fw-bold text-success" style="text-shadow: 0 1px 2px rgba(0,0,0,0.5);">
                                    {{ oeuvre.price|number_format(2, ',', ' ') }} TND
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-muted small mb-2">
                            <i class="bi bi-eye"></i> {{ oeuvre.viewsCount }} vues
                            <div class="mt-2 d-flex gap-2">
                                <a href="{{ path('app_oeuvre_details', {id: oeuvre.id}) }}" class="btn btn-sm btn-outline-primary flex-grow-1">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_oeuvre_download', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-secondary flex-grow-1" title="Télécharger">
                                     <i class="bi bi-download"></i> Télécharger
                                </a>
                                <a href="{{ path('app_vente', {id: oeuvre.id}) }}" class="btn btn-sm btn-outline-success flex-grow-1">
                                    <i class="bi bi-cart"></i> Acheter
                                </a>
                            </div>
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-5">
        <div class="mb-4" style="font-size: 5rem; opacity: 0.3;">🎨</div>
        <h4 class="text-muted">Aucune œuvre trouvée</h4>
        <p class="text-muted">Essayez de modifier vos critères de recherche</p>
    </div>
{% endif %}
