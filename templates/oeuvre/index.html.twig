{% extends 'base.html.twig' %}

{% block title %}Galerie{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour au Dashboard
        </a>
        <h1 class="mb-0">Mes Œuvres</h1>
    </div>
    <a href="{{ path('app_oeuvre_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter une œuvre
    </a>
</div>

{% if oeuvres|length == 0 %}
    <div class="alert alert-info">
        <p class="mb-0">Vous n'avez pas encore d'œuvres. <a href="{{ path('app_oeuvre_new') }}">Ajoutez-en une maintenant !</a></p>
    </div>
{% else %}
    <div class="row">
        {% for oeuvre in oeuvres %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    {% if oeuvre.imagePath %}
                        <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" class="card-img-top oeuvre-image" alt="{{ oeuvre.title }}">
                    {% else %}
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ oeuvre.title }}</h5>
                        <p class="card-text text-truncate">{{ oeuvre.description }}</p>
                        <div class="mb-2">
                            <span class="badge bg-{{ oeuvre.status == 'public' ? 'success' : (oeuvre.status == 'draft' ? 'warning' : 'secondary') }}">
                                {{ oeuvre.status|upper }}
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_oeuvre_download', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-secondary" title="Télécharger">
                                <i class="bi bi-download"></i> Télécharger
                            </a>
                            <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <small>
                            <i class="bi bi-eye"></i> {{ oeuvre.viewsCount }}
                            <i class="bi bi-hand-thumbs-up ms-2"></i> {{ oeuvre.votesCount }}
                        </small>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>

<style>
/* Animation de la carte */
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
}

/* Focus des champs de formulaire */
.form-control:focus, .form-select:focus {
    border-color: #212529;
    box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.25);
}

/* Alignement parfait du formulaire de recherche */
.row.align-items-center {
    align-items: stretch !important;
}

.row.align-items-center > div {
    display: flex;
    align-items: stretch;
}

.row.align-items-center .form-control,
.row.align-items-center .form-select,
.row.align-items-center .btn {
    height: 48px !important;
    min-height: 48px;
    max-height: 48px;
    line-height: normal;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    box-sizing: border-box;
    border-width: 1px;
    border-style: solid;
    display: flex;
    align-items: center;
    margin: 0;
    vertical-align: middle;
}

.row.align-items-center .btn {
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;
}

.row.align-items-center .form-select {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}

/* Container des boutons d'action */
.card-footer .d-flex {
    display: flex !important;
    gap: 0.5rem;
}

/* Taille égale pour les conteneurs des boutons */
.card-footer .d-flex > a,
.card-footer .d-flex > form {
    flex: 1 1 0;
    min-width: 0;
}

/* Style uniforme pour tous les boutons d'action */
.action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    transition: all 0.3s ease;
    height: 38px;
    width: 100%;
    box-sizing: border-box;
    border-width: 1px;
    border-style: solid;
}

/* Icône dans les boutons */
.btn-icon {
    margin-right: 0.5rem;
}

/* Effet hover bouton Modifier */
.btn-outline-dark:hover {
    background-color: #212529;
    color: white;
    transform: translateY(-2px);
}

/* Effet hover bouton Supprimer */
.btn-outline-danger:hover {
    background-color: #dc3545;
    color: white;
    transform: translateY(-2px);
}
</style>
{% endblock %}
