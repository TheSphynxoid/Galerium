{% extends 'base.html.twig' %}

{% block title %}Mes Œuvres - Galerium{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour au Dashboard
        </a>
        <h1 class="mb-0">Mes Œuvres</h1>
    </div>
    <a href="{{ path('app_oeuvre_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter une œuvre
    </a>
</div>

{% if oeuvres|length == 0 %}
    <div class="alert alert-info">
        <p class="mb-0">Vous n'avez pas encore d'œuvres. <a href="{{ path('app_oeuvre_new') }}">Ajoutez-en une maintenant !</a></p>
    </div>
{% else %}
    <div class="row">
        {% for oeuvre in oeuvres %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    {% if oeuvre.imagePath %}
                        <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" class="card-img-top oeuvre-image" alt="{{ oeuvre.title }}">
                    {% else %}
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ oeuvre.title }}</h5>
                        <p class="card-text text-truncate">{{ oeuvre.description }}</p>
                        <div class="mb-2">
                            <span class="badge bg-{{ oeuvre.status == 'public' ? 'success' : (oeuvre.status == 'draft' ? 'warning' : 'secondary') }}">
                                {{ oeuvre.status|upper }}
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_oeuvre_download', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-secondary" title="Télécharger">
                                <i class="bi bi-download"></i> Télécharger
                            </a>
                            <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <small>
                            <i class="bi bi-eye"></i> {{ oeuvre.viewsCount }}
                            <i class="bi bi-hand-thumbs-up ms-2"></i> {{ oeuvre.votesCount }}
                        </small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
