{% extends 'base.html.twig' %}

{% block title %}{{ oeuvre.title }} - Galerium{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    {% if oeuvre.imagePath %}
                        <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" class="card-img-top" alt="{{ oeuvre.title }}">
                    {% else %}
                        <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 400px;">
                            <i class="bi bi-image text-white" style="font-size: 5rem;"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h1 class="card-title">{{ oeuvre.title }}</h1>
                        <p class="text-muted">
                            <strong>Artiste:</strong> {{ oeuvre.artiste.displayName }}<br>
                            <strong>Date de création:</strong> {{ oeuvre.createdAt|date('d/m/Y') }}<br>
                            <strong>Statut:</strong> 
                            {% if oeuvre.status == 'public' %}
                                <span class="badge bg-success">Publié</span>
                            {% elseif oeuvre.status == 'draft' %}
                                <span class="badge bg-secondary">Brouillon</span>
                            {% elseif oeuvre.status == 'private' %}
                                <span class="badge bg-warning text-dark">Privé</span>
                            {% else %}
                                <span class="badge bg-dark">Archivé</span>
                            {% endif %}
                        </p>
                        {% if oeuvre.price %}
                            <p><strong>Prix:</strong> {{ oeuvre.price }} TND</p>
                        {% endif %}
                        <hr>
                        <h5>Description</h5>
                        <p>{{ oeuvre.description }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Statistiques</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Vues:</strong> {{ oeuvre.viewsCount }}</p>
                        <p><strong>Votes:</strong> {{ oeuvre.votesCount }}</p>
                        <p><strong>Favoris:</strong> {{ oeuvre.favoritesCount }}</p>
                        <p class="mb-0"><strong>Commentaires:</strong> {{ oeuvre.isCommentable ? 'Autorisés' : 'Désactivés' }}</p>
                    </div>
                </div>
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body">
                        <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left"></i> Retour au dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}







