{% extends 'base.html.twig' %}
{% block title %}{{ oeuvre.title }}{% endblock %}

{% block body %}
<section id="oeuvre-detail" class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-7">
                <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                     alt="{{ oeuvre.title }}" 
                     class="img-fluid rounded shadow">
            </div>
            <div class="col-md-5">
                <h1 class="mb-3">{{ oeuvre.title }}</h1>
                <p class="text-muted mb-4">
                    Par <a href="{{ path('app_artiste_show', {slug: oeuvre.artiste.slug}) }}" 
                           class="text-decoration-none text-dark fw-bold">
                        {{ oeuvre.artiste.displayName }}
                    </a>
                </p>
                <p class="mb-4">{{ oeuvre.description }}</p>
                
                <div class="d-flex gap-4 mb-4 text-muted">
                    <div>
                        <strong>{{ oeuvre.viewsCount }}</strong> vues
                    </div>
                    <div>
                        <strong>{{ oeuvre.votesCount }}</strong> votes
                    </div>
                    <div>
                        <strong>{{ oeuvre.favoritesCount }}</strong> favoris
                    </div>
                </div>

                {% if oeuvre.categories|length > 0 %}
                    <div class="mb-4">
                        <h6 class="text-muted mb-2">Catégories</h6>
                        <div class="d-flex flex-wrap gap-2">
                            {% for categorie in oeuvre.categories %}
                                <span class="badge bg-secondary">{{ categorie.name }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
