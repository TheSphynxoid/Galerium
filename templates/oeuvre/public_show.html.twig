{% extends 'base.html.twig' %}

{% block title %}{{ oeuvre.title }} - Galerium{% endblock %}

{% block body %}
<section class="py-5 bg-light">
    <div class="container">
        {# Navigation #}
        <div class="row mb-4">
            <div class="col-12">
                <a href="{{ path('app_oeuvre_gallery') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la galerie
                </a>
            </div>
        </div>

        <div class="row g-5">
            {# Image Section #}
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm overflow-hidden">
                    <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                         class="img-fluid w-100" 
                         alt="{{ oeuvre.title }}" 
                         style="object-fit: cover; max-height: 600px;">
                </div>
            </div>

            {# Details Section #}
            <div class="col-lg-5">
                <div class="bg-white p-5 rounded shadow-sm h-100">
                    <h1 class="display-5 fw-bold mb-2">{{ oeuvre.title }}</h1>
                    <p class="fs-5 text-muted mb-4">
                        Par <a href="{{ path('app_artiste_show', {id: oeuvre.artiste.id}) }}" class="text-decoration-none text-dark hover-underline">{{ oeuvre.artiste.displayName }}</a>
                    </p>

                    <div class="d-flex align-items-center mb-4">
                        <span class="badge bg-secondary me-2">{{ oeuvre.viewsCount }} vues</span>
                        {# Add date if available #}
                        <span class="text-muted small"><i class="bi bi-calendar"></i> Ajouté le {{ oeuvre.createdAt|date('d/m/Y') }}</span>
                    </div>

                    {% if oeuvre.description %}
                        <div class="mb-5">
                            <h5 class="fw-bold mb-3">À propos de l'œuvre</h5>
                            <p class="text-muted" style="line-height: 1.8;">
                                {{ oeuvre.description|nl2br }}
                            </p>
                        </div>
                    {% endif %}

                    <div class="d-grid gap-3">
                        <a href="{{ path('app_oeuvre_download', {'id': oeuvre.id}) }}" class="btn btn-outline-dark btn-lg">
                            <i class="bi bi-download me-2"></i> Télécharger l'image
                        </a>
                         {% if oeuvre.price %}
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fs-4 fw-light">Prix</span>
                                <span class="fs-2 fw-bold text-success">{{ oeuvre.price|number_format(2, ',', ' ') }} TND</span>
                            </div>
                            <a href="{{ path('app_vente', {id: oeuvre.id}) }}" class="btn btn-dark btn-lg">
                                <i class="bi bi-cart-check me-2"></i> Acheter cette œuvre
                            </a>
                        {% else %}
                             <button class="btn btn-secondary btn-lg" disabled>
                                Non disponible à la vente
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.hover-underline:hover {
    text-decoration: underline !important;
}
</style>
{% endblock %}
