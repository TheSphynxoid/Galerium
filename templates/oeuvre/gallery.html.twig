{% extends 'base.html.twig' %}

{% block title %}Galerie - Galerium{% endblock %}

{% block body %}
<section id="galerie" class="py-5 bg-light">
    <div class="container">
        {% if is_granted('ROLE_ARTISTE') %}
        <div class="row mb-4">
            <div class="col-12">
                <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour au Dashboard
                </a>
            </div>
        </div>
        {% endif %}
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="section-title display-4 fw-bold mb-3">Galerie d'Art</h2>
                <p class="text-muted fs-5">Explorez les œuvres de nos artistes</p>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="bg-white p-4 rounded shadow-sm">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-12">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="search" 
                                       id="search-input"
                                       class="form-control border-start-0" 
                                       placeholder="Rechercher une œuvre, un artiste..." 
                                       value="{{ searchQuery|default('') }}">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="gallery-content" style="min-height: 400px; position: relative;">
             {% include 'oeuvre/_gallery_content.html.twig' %}
        </div>
    </div>
</section>
//ajax /////////////////// 
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('search-input');
        const galleryContent = document.getElementById('gallery-content');
        let timeoutId;

        // Loading spinner
        const spinner = `
            <div class="position-absolute top-50 start-50 translate-middle text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
        `;

        searchInput.addEventListener('input', function(e) {
            clearTimeout(timeoutId);
            const query = e.target.value;

            // Show spinner only if query is not empty (optional UX choice)
            galleryContent.style.opacity = '0.5';

            timeoutId = setTimeout(() => {
                fetch(`{{ path('app_oeuvre_gallery') }}?ajax=1&q=${encodeURIComponent(query)}`)
                    .then(response => response.text())
                    .then(html => {
                        galleryContent.innerHTML = html;
                        galleryContent.style.opacity = '1';
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        galleryContent.style.opacity = '1';
                    });
            }, 300); // 300ms debounce
        });
    });
</script>
//ajax //////////////////////
<style>
/* Animation de la carte */
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
}

/* Focus des champs de formulaire */
.form-control:focus {
    border-color: #dee2e6;
    box-shadow: none;
}

.input-group:focus-within {
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    border-radius: 0.375rem;
}

.input-group:focus-within .form-control, 
.input-group:focus-within .input-group-text {
    border-color: #86b7fe;
}
</style>
{% endblock %}
