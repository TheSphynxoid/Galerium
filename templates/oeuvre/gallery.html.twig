{% extends 'base.html.twig' %}

{% block title %}Galerie - Galerium{% endblock %}

{% block body %}
<section id="galerie" class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour au Dashboard
                </a>
            </div>
        </div>
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="section-title display-4 fw-bold mb-3">Galerie d'Art</h2>
                <p class="text-muted fs-5">Explorez les œuvres de nos artistes</p>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <form method="get" class="bg-white p-4 rounded shadow-sm">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <input type="search" 
                                   name="artiste" 
                                   class="form-control" 
                                   placeholder="👤 Nom de l'artiste..." 
                                   value="{{ app.request.get('artiste') }}">
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-dark w-100 fw-bold" type="submit">
                                🔍 Filtrer
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {% if oeuvres|length > 0 %}
            <div class="row g-4">
                {% for oeuvre in oeuvres %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
                            <div class="position-relative overflow-hidden" style="height: 300px;">
                                <a href="{{ path('app_artiste_show', {id: oeuvre.artiste.id}) }}" class="d-block w-100 h-100">
                                    <img src="{{ vich_uploader_asset(oeuvre, 'imageFile') }}" 
                                         class="w-100 h-100" 
                                         alt="{{ oeuvre.title }}" 
                                         style="object-fit: cover; transition: transform 0.3s ease;"
                                         onmouseover="this.style.transform='scale(1.05)'"
                                         onmouseout="this.style.transform='scale(1)'">
                                </a>
                                <div class="position-absolute top-0 start-0 w-100 h-100" 
                                     style="background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.7) 100%);"></div>
                                <div class="position-absolute bottom-0 start-0 p-3 text-white w-100">
                                    <h5 class="mb-1 fw-bold">{{ oeuvre.title }}</h5>
                                    <p class="mb-0 small opacity-75">
                                        Par <a href="{{ path('app_artiste_show', {id: oeuvre.artiste.id}) }}" class="text-white text-decoration-none hover-underline">{{ oeuvre.artiste.displayName }}</a>
                                    </p>
                                    {% if oeuvre.price %}
                                        <p class="mb-0 mt-1 fw-bold text-success" style="text-shadow: 0 1px 2px rgba(0,0,0,0.5);">
                                            {{ oeuvre.price|number_format(2, ',', ' ') }} TND
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-muted small mb-2">
                                    <i class="bi bi-eye"></i> {{ oeuvre.viewsCount }} vues
                                    <div class="mt-2">
                                        <a href="{{ path('app_vente', {id: oeuvre.id}) }}" class="btn btn-sm btn-outline-success w-100">
                                            <i class="bi bi-cart"></i> Acheter
                                        </a>
                                    </div>
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-5">
                <div class="mb-4" style="font-size: 5rem; opacity: 0.3;">🎨</div>
                <h4 class="text-muted">Aucune œuvre trouvée</h4>
                <p class="text-muted">Essayez de modifier vos critères de recherche</p>
            </div>
        {% endif %}
    </div>
</section>

<style>
/* Animation de la carte */
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
}

/* Focus des champs de formulaire */
.form-control:focus, .form-select:focus {
    border-color: #212529;
    box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.25);
}

/* Alignement parfait du formulaire de recherche */
.row.align-items-center {
    align-items: stretch !important;
}

.row.align-items-center > div {
    display: flex;
    align-items: stretch;
}

.row.align-items-center .form-control,
.row.align-items-center .form-select,
.row.align-items-center .btn {
    height: 48px !important;
    min-height: 48px;
    max-height: 48px;
    line-height: normal;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    box-sizing: border-box;
    border-width: 1px;
    border-style: solid;
    display: flex;
    align-items: center;
    margin: 0;
    vertical-align: middle;
}

.row.align-items-center .btn {
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;
}

.row.align-items-center .form-select {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
}
</style>
{% endblock %}
