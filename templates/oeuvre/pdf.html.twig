<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ oeuvre.title }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
        }
        .title {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .artist {
            font-size: 16px;
            color: #666;
        }
        .image-container {
            text-align: center;
            margin-bottom: 30px;
        }
        .image-container img {
            max-width: 100%;
            max-height: 500px;
            border: 1px solid #ddd;
        }
        .details {
            margin-bottom: 30px;
        }
        .description {
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }
        .meta {
            margin-top: 20px;
            font-size: 12px;
            color: #888;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">{{ oeuvre.title }}</div>
        <div class="artist">Par {{ oeuvre.artiste.displayName }}</div>
    </div>

    <div class="image-container">
        {# Use absolute path for images in PDF #}
        {% if oeuvre.imagePath %}
            <img src="{{ imagePath }}" alt="{{ oeuvre.title }}">
        {% endif %}
    </div>

    <div class="details">
        {% if oeuvre.price %}
            <div style="font-size: 18px; font-weight: bold; color: #28a745; text-align: center; margin-bottom: 20px;">
                Prix: {{ oeuvre.price|number_format(2, ',', ' ') }} TND
            </div>
        {% endif %}

        {% if oeuvre.description %}
            <div class="description">
                <strong>À propos de l'œuvre:</strong><br>
                {{ oeuvre.description|nl2br }}
            </div>
        {% endif %}
    </div>

    <div class="meta">
        <p>Téléchargé depuis Galerium le {{ "now"|date("d/m/Y") }}</p>
    </div>
</body>
</html>
