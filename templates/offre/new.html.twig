{% extends 'base.html.twig' %}

{% block title %}Enchérir - {{ enchere.oeuvre.title }}{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row">
        {# Artwork column #}
        <div class="col-md-5 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-img-top position-relative bg-light" style="height: 350px; overflow: hidden;">
                    <img src="{{ vich_uploader_asset(enchere.oeuvre, 'imageFile') }}" alt="{{ enchere.oeuvre.title }}" style="width: 100%; height: 100%; object-fit: cover;" class="">
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ enchere.oeuvre.title }}</h5>
                    {% if enchere.oeuvre.artiste %}
                        <p class="card-text text-muted">par <strong>{{ enchere.oeuvre.artiste.displayName }}</strong></p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Bidding column #}
        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-4">Placer une enchère</h3>

                    {# Auction Status #}
                    <div class="alert alert-info mb-4">
                        <div class="row">
                            <div class="col-6">
                                <div class="small text-muted">Meilleure enchère</div>
                                <h4 class="mb-0">{{ enchere.prixActuel|number_format(2, ',', ' ') }} TND</h4>
                            </div>
                            <div class="col-6 text-right">
                                <div class="small text-muted">Enchère minimale</div>
                                <h4 class="mb-0">{{ (enchere.prixActuel + (enchere.minIncrement ?? 1))|number_format(2, ',', ' ') }} TND</h4>
                            </div>
                        </div>
                    </div>

                    {# Auction Info Cards #}
                    <div class="row mb-4">
                        <div class="col-6 mb-3">
                            <div class="card bg-light border-0">
                                <div class="card-body p-3">
                                    <div class="small text-muted">Fin de l'enchère</div>
                                    <p class="mb-0 font-weight-bold">
                                        {% if enchere.dateFin %}
                                            {{ enchere.dateFin|date('d/m/Y H:i') }}
                                        {% else %}
                                            Non définie
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="card bg-light border-0">
                                <div class="card-body p-3">
                                    <div class="small text-muted">Nombre d'offres</div>
                                    <p class="mb-0 font-weight-bold">{{ enchere.offre|length }}</p>
                                </div>
                            </div>
                        </div>
                        {% if enchere.reservePrice %}
                            <div class="col-6 mb-3">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <div class="small text-muted">Prix de réserve</div>
                                        <p class="mb-0 font-weight-bold">{{ enchere.reservePrice|number_format(2, ',', ' ') }} TND</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if enchere.minIncrement %}
                            <div class="col-6 mb-3">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <div class="small text-muted">Incrément minimum</div>
                                        <p class="mb-0 font-weight-bold">{{ enchere.minIncrement|number_format(2, ',', ' ') }} TND</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {# Bidding Form #}
                    {{ include('offre/_form.html.twig', {'button_label': 'Enchérir maintenant'}) }}

                    {# Rules Info #}
                    <div class="alert alert-warning mt-4" role="alert">
                        <h6 class="alert-heading">📋 Règles d'enchère</h6>
                        <ul class="mb-0 small">
                            <li>Votre enchère doit être supérieure de {{ enchere.minIncrement ?? 1 }} TND au moins</li>
                            {% if enchere.reservePrice %}
                                <li>Le prix de réserve est {{ enchere.reservePrice|number_format(2, ',', ' ') }} TND</li>
                            {% endif %}
                            <li>Enchérir dans les 2 dernières minutes prolonge l'enchère</li>
                            <li>Vous recevrez un email si vous êtes surenchéri</li>
                        </ul>
                    </div>

                    <div class="mt-3 text-center">
                        <a class="btn btn-secondary btn-sm" href="{{ path('app_enchere_index') }}">← Retour aux enchères</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card { transition: transform 0.2s, box-shadow 0.2s; }
.card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; }
</style>
{% endblock %}
