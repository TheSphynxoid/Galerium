{% extends 'base.html.twig' %}

{% block title %}Signaler un utilisateur{% endblock %}

{% block body %}
<div style="max-width: 700px; margin: 40px auto; padding: 20px; border-radius: 10px; background: #f8f9fa; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h2>Signaler {{ user.nom }} {{ user.prenom }}</h2>

    {{ form_start(form) }}
        {{ form_row(form.reason) }}

        <button type="submit" style="padding: 10px 20px; background: #dc3545; color: white; border-radius: 6px; border: none;">
            Envoyer le signalement
        </button>
    {{ form_end(form) }}

    <a href="{{ path('app_admin') }}" style="display:inline-block; margin-top: 20px; padding: 10px 20px; background: #007bff; color: white; border-radius: 6px; text-decoration: none;">
        Retour au dashboard
    </a>
</div>
{% endblock %}
