{% extends 'backoffice.html.twig' %}

{% block title %}Administration des Œuvres{% endblock %}

{% block body %}
<div class="body flex-grow-1">
    <div class="container-lg px-4">
        <div class="card mb-4">
            <div class="card-header">
                <strong>Administration des Œuvres</strong>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Artiste</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for oeuvre in oeuvres %}
                            <tr>
                                <td>{{ oeuvre.id }}</td>
                                <td>{{ oeuvre.title }}</td>
                                <td>
                                    {% if oeuvre.status == 'published' %}
                                        <span class="badge bg-success">Publiée</span>
                                    {% elseif oeuvre.status == 'draft' %}
                                        <span class="badge bg-secondary">Brouillon</span>
                                    {% elseif oeuvre.status == 'private' %}
                                        <span class="badge bg-warning text-dark">Privée</span>
                                    {% elseif oeuvre.status == 'archived' %}
                                        <span class="badge bg-dark">Archivée</span>
                                    {% else %}
                                        <span class="badge bg-info">{{ oeuvre.status }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ oeuvre.artiste ? oeuvre.artiste.displayName : 'N/A' }}</td>
                                <td>
                                    <a href="{{ path('admin_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-sm btn-warning text-white">
                                        <svg class="icon">
                                            <use xlink:href="{{ asset('vendors/@coreui/icons/svg/free.svg') }}#cil-pencil"></use>
                                        </svg>
                                        Modifier
                                    </a>
                                    <form method="post" action="{{ path('admin_oeuvre_delete', {'id': oeuvre.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette œuvre ?');" class="d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ oeuvre.id) }}">
                                        <button class="btn btn-sm btn-danger text-white">
                                            <svg class="icon">
                                                <use xlink:href="{{ asset('vendors/@coreui/icons/svg/free.svg') }}#cil-trash"></use>
                                            </svg>
                                            Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">Aucune œuvre trouvée</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
