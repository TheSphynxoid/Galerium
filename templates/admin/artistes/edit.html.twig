{% extends 'backoffice.html.twig' %}

{% block title %}Modifier l'artiste{% endblock %}

{% block body %}
<section class="py-4">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Modifier le profil artiste : {{ artiste.displayName }}</h3>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                {% if form_errors(form) is not empty %}
                    <div class="alert alert-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.displayName, 'Nom d\'artiste *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.displayName, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.displayName) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.specialty, 'Spécialité *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.specialty, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.specialty) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.biography, 'Biographie *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.biography, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.biography) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.website, 'Site web *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.website, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.website) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <h5 class="mb-3 mt-3">Réseaux sociaux</h5>
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.facebook, 'Facebook', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.facebook, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.instagram, 'Instagram', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.instagram, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.behance, 'Behance', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.behance, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="col-12">
                        {{ form_label(form.imageFile, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="col-12 mt-4">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                            <a href="{{ path('app_admin_artiste_list') }}" class="btn btn-secondary">Annuler</a>
                        </div>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
