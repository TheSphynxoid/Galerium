{% extends 'base.html.twig' %}

{% block title %}Mon profil artiste{% endblock %}

{% block body %}
<section id="profile-edit" class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="mb-4">Mon profil artiste</h2>



                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

                {% if form_errors(form) is not empty %}
                    <div class="alert alert-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.displayName, 'Nom d\'artiste *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.displayName, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.displayName) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.specialty, 'Spécialité *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.specialty, {'attr': {'class': 'form-control'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.specialty) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.biography, 'Biographie *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.biography, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.biography) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.website, 'Site web *', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.website, {'attr': {'class': 'form-control', 'placeholder': 'https://'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.website) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <h5 class="mb-3">Réseaux sociaux (facultatif)</h5>
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.facebook, 'Facebook', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.facebook, {'attr': {'class': 'form-control', 'placeholder': 'https://facebook.com/...'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.facebook) }}
                        </div>
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.instagram, 'Instagram', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.instagram, {'attr': {'class': 'form-control', 'placeholder': 'https://instagram.com/...'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.instagram) }}
                        </div>
                    </div>

                    <div class="col-md-4">
                        {{ form_label(form.behance, 'Behance', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.behance, {'attr': {'class': 'form-control', 'placeholder': 'https://behance.net/...'}}) }}
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.behance) }}
                        </div>
                    </div>

                    <div class="col-12">
                        {{ form_label(form.imageFile, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-text">Formats acceptés : JPG, PNG. Taille max : 5MB</div>
                        <div class="invalid-feedback d-block">
                            {{ form_errors(form.imageFile) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary form-action-btn">Enregistrer</button>
                            <a href="{{ path('app_artiste_dashboard') }}" class="btn btn-outline-secondary form-action-btn">Annuler</a>
                        </div>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>

<style>
.form-action-btn {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0.5rem 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}
.form-action-btn:hover {
    transform: translateY(-2px);
}
.d-flex.gap-2 { gap: 0.5rem; }
</style>
{% endblock %}
