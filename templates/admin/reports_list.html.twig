{% extends 'base.html.twig' %}

{% block title %}Liste des signalements{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 40px auto; padding: 20px; border-radius: 10px; background: #f8f9fa; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h2>Liste des signalements</h2>

    <table style="width:100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="background: #007bff; color: white;">
                <th style="padding:10px; border:1px solid #dee2e6;">ID</th>
                <th style="padding:10px; border:1px solid #dee2e6;">Utilisateur signalé</th>
                <th style="padding:10px; border:1px solid #dee2e6;">Signalé par</th>
                <th style="padding:10px; border:1px solid #dee2e6;">Raison</th>
                <th style="padding:10px; border:1px solid #dee2e6;">Date</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
                <tr>
                    <td style="padding:10px; border:1px solid #dee2e6;">{{ report.id }}</td>
                    <td style="padding:10px; border:1px solid #dee2e6;">{{ report.reportedUser.nom }} {{ report.reportedUser.prenom }}</td>
                    <td style="padding:10px; border:1px solid #dee2e6;">{{ report.reportedBy.nom }} {{ report.reportedBy.prenom }}</td>
                    <td style="padding:10px; border:1px solid #dee2e6;">{{ report.reason }}</td>
                    <td style="padding:10px; border:1px solid #dee2e6;">{{ report.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="padding:10px; text-align:center;">Aucun signalement</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin') }}" style="display:inline-block; margin-top: 20px; padding: 10px 20px; background: #007bff; color: white; border-radius: 6px; text-decoration: none;">
        Retour au dashboard
    </a>
</div>
{% endblock %}
