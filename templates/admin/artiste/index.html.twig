{% extends 'backoffice.html.twig' %}

{% block title %}Administration des Artistes{% endblock %}

{% block body %}
<div class="body flex-grow-1">
    <div class="container-lg px-4">
        <div class="card mb-4">
            <div class="card-header">
                <strong>Administration des Artistes</strong>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nom d'artiste</th>
                                <th>Spécialité</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for artiste in artistes %}
                            <tr>
                                <td>{{ artiste.id }}</td>
                                <td>{{ artiste.displayName }}</td>
                                <td>{{ artiste.specialty }}</td>
                                <td>
                                    <a href="{{ path('admin_artiste_edit', {'id': artiste.id}) }}" class="btn btn-sm btn-warning text-white">
                                        <svg class="icon">
                                            <use xlink:href="{{ asset('vendors/@coreui/icons/svg/free.svg') }}#cil-pencil"></use>
                                        </svg>
                                        Modifier
                                    </a>
                                    <form method="post" action="{{ path('admin_artiste_delete', {'id': artiste.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet artiste ?');" class="d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artiste.id) }}">
                                        <button class="btn btn-sm btn-danger text-white">
                                            <svg class="icon">
                                                <use xlink:href="{{ asset('vendors/@coreui/icons/svg/free.svg') }}#cil-trash"></use>
                                            </svg>
                                            Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center">Aucun artiste trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
